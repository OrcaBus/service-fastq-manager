{
  "Comment": "A description of my state machine",
  "StartAt": "Set vars",
  "States": {
    "Set vars": {
      "Type": "Pass",
      "Next": "Set Keys",
      "Assign": {
        "jobId": "{% $states.input.jobId %}",
        "fastqId": "{% $states.input.fastqId %}",
        "libraryId": "{% $states.input.libraryId %}",
        "cacheBucket": "${__fastq_manager_cache_bucket__}",
        "cacheKey": "{% '${__fastq_manager_cache_prefix__}' & $now('year=[Y0001]/month=[M01]/day=[D01]/') & $states.context.Execution.Name & '/' & $states.input.fastqId & '.json' %}",
        "sequaliBucket": "${__fastq_manager_sequali_output_bucket__}",
        "sequaliMidFix": "{% $now('year=[Y0001]/month=[M01]/day=[D01]/') & $states.context.Execution.Name & '/' & $states.input.fastqId %}",
        "picardBucket": "${__fastq_manager_sequali_output_bucket__}",
        "picardMidFix": "{% $now('year=[Y0001]/month=[M01]/day=[D01]/') & $states.context.Execution.Name & '/' & $states.input.fastqId %}"
      }
    },
    "Set Keys": {
      "Type": "Pass",
      "Next": "Wait for Read Count",
      "Assign": {
        "sequaliHtmlKey": "{% '${__fastq_manager_sequali_html_prefix__}' & $sequaliMidFix & '.html' %}",
        "sequaliParquetKey": "{% '${__fastq_manager_sequali_parquet_prefix__}' & $sequaliMidFix & '.parquet' %}",
        "multiqcHtmlKey": "{% '${__fastq_manager_multiqc_html_prefix__}' & $sequaliMidFix & '.html' %}",
        "multiqcParquetKey": "{% '${__fastq_manager_multiqc_parquet_prefix__}' & $sequaliMidFix & '.parquet' %}",
        "picardPdfKey": "{% '${__fastq_manager_picard_pdf_prefix__}' & $picardMidFix & '.pdf' %}",
        "picardParquetKey": "{% '${__fastq_manager_picard_parquet_prefix__}' & $picardMidFix & '.parquet' %}",
        "multiqcPicardHtmlKey": "{% '${__fastq_manager_multiqc_picard_html_prefix__}' & $picardMidFix & '.html' %}",
        "multiqcPicardParquetKey": "{% '${__fastq_manager_multiqc_picard_parquet_prefix__}' & $picardMidFix & '.parquet' %}",
        "picardSummaryKey": "{% '${__fastq_manager_cache_prefix__}' & $now('year=[Y0001]/month=[M01]/day=[D01]/') & $states.context.Execution.Name & '/' & $states.input.fastqId & '.picard.json' %}"
      }
    },
    "Wait for Read Count": {
      "Type": "Task",
      "Resource": "arn:aws:states:::events:putEvents.waitForTaskToken",
      "Arguments": {
        "Entries": [
          {
            "Detail": {
              "taskToken": "{% $states.context.Task.Token %}",
              "payload": {
                "fastqIdList": ["{% $fastqId %}"],
                "requirements": {
                  "hasReadCountInformation": true
                }
              }
            },
            "DetailType": "${__fastq_sync_detail_type__}",
            "EventBusName": "${__event_bus_name__}",
            "Source": "${__stack_source__}"
          }
        ]
      },
      "Next": "Get fastq object"
    },
    "Get fastq object": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Arguments": {
        "FunctionName": "${__get_fastq_object_with_s3_objs_lambda_function_arn__}",
        "Payload": {
          "fastqId": "{% $fastqId %}"
        }
      },
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException"
          ],
          "IntervalSeconds": 1,
          "MaxAttempts": 3,
          "BackoffRate": 2,
          "JitterStrategy": "FULL"
        }
      ],
      "Next": "QC Parallel Flow",
      "Assign": {
        "s3Objs": "{% $states.result.Payload.s3Objs %}",
        "fastqObj": "{% $states.result.Payload.fastqObj %}"
      }
    },
    "QC Parallel Flow": {
      "Type": "Parallel",
      "Next": "Merge branch outputs",
      "Branches": [
        {
          "StartAt": "Is ORA compression",
          "States": {
            "Is ORA compression": {
              "Type": "Choice",
              "Choices": [
                {
                  "Next": "Decompress Fastqs",
                  "Condition": "{% $fastqObj.readSet.compressionFormat = 'ORA' %}",
                  "Comment": "Is ORA Compression Format"
                }
              ],
              "Default": "Calculate Ephemeral Storage Size"
            },
            "Decompress Fastqs": {
              "Type": "Task",
              "Resource": "arn:aws:states:::events:putEvents.waitForTaskToken",
              "Arguments": {
                "Entries": [
                  {
                    "Detail": {
                      "taskToken": "{% $states.context.Task.Token %}",
                      "payload": {
                        "fastqIdList": ["{% $fastqId %}"],
                        "maxReads": "{% (\n  /* Min reads, 50 million */\n  $minReads := (\"${__min_sequali_reads__}\" ~> $number);\n  /* Max reads, 500 million */\n  $maxReads :=  (\"${__max_sequali_reads__}\" ~> $number);\n  /* Our output will be somewhere in the middle, unless there is less than $minReads */\n  ( $fastqObj.readCount < $minReads ) ? (\n    /* Less than min reads */\n    $fastqObj.readCount\n  ) : (\n    /* We have more than min reads */\n    $min([\n      (\n        /* Like a taxation after 50 million */\n        $sum(\n          [\n            /* Take the first 50 million free of tax */\n            $minReads,\n            /* Tax the remaining at 50 pct */\n            $round(0.5 * ($fastqObj.readCount - $minReads))\n          ]\n        )\n      ),\n      /* This is our upper bound */\n      $maxReads\n    ])\n  )\n) %}",
                        "sampling": true
                      }
                    },
                    "DetailType": "${__ora_decompression_request_detail_type__}",
                    "EventBusName": "${__event_bus_name__}",
                    "Source": "${__stack_source__}"
                  }
                ]
              },
              "Next": "Calculate Ephemeral Storage Size",
              "Catch": [
                {
                  "ErrorEquals": ["States.TaskFailed"],
                  "Next": "Sequali Branch Result",
                  "Assign": {
                    "jobStatus": "FAILED"
                  }
                }
              ],
              "Assign": {
                "sequaliS3Objs": "{% (\n    $getFastqIngestIdList := function($decompressedFileList, $fastqId) {(\n        /* Start with the decompressedFileList input */\n        $decompressedFileList ~>\n        /* Get the only item in the list where the fastq id matches */\n        $single(\n            function($decompressedFileListIter){\n                $decompressedFileListIter.fastqId = $fastqId\n            }\n        ) ~>\n        /* Get the ingest id list */\n        $lookup('decompressedFileUriByOraFileIngestIdList')\n    )};\n    $getR1FileObjFilter := function($s3ObjIter){\n        $s3ObjIter.ingestId = $s3Objs[0].ingestId\n    };\n    $getR2FileObjFilter := function($s3ObjIter) {(\n        $s3ObjIter.ingestId = $s3Objs[1].ingestId\n    )};\n    $getFileUri := function($fastqFileList, $filterFunction){\n        /* Start with the fastq file list */\n        $fastqFileList ~>\n        /* Pipe into single, which collects the filter function */\n        $single($filterFunction) ~>\n        /* And then get the gzipFileUri attribute */\n        $lookup('gzipFileUri')\n    };\n\n    /* Start with the decompressedFileList input */\n    $fastqFileList := $getFastqIngestIdList(\n        $states.result.decompressedFileList,\n        $fastqId\n    );\n\n    /* Collect the iterable that matches the ingest id */\n    [\n        {\n            's3Uri': ($fastqFileList ~> $getFileUri($getR1FileObjFilter))\n        },\n        {\n            's3Uri': ($fastqFileList ~> $getFileUri($getR2FileObjFilter))\n        }\n    ]\n) %}"
              },
              "Retry": [
                {
                  "ErrorEquals": ["States.HeartbeatTimeout"],
                  "BackoffRate": 2,
                  "IntervalSeconds": 1,
                  "MaxAttempts": 1
                }
              ],
              "HeartbeatSeconds": 3600
            },
            "Calculate Ephemeral Storage Size": {
              "Type": "Task",
              "Resource": "arn:aws:states:::lambda:invoke",
              "Output": "{% $states.result.Payload %}",
              "Arguments": {
                "FunctionName": "${__calculate_ephemeral_size_lambda_function_arn__}",
                "Payload": {
                  "s3Objs": "{% $exists($sequaliS3Objs) ? $sequaliS3Objs : $s3Objs %}"
                }
              },
              "Retry": [
                {
                  "ErrorEquals": [
                    "Lambda.ServiceException",
                    "Lambda.AWSLambdaException",
                    "Lambda.SdkClientException",
                    "Lambda.TooManyRequestsException"
                  ],
                  "IntervalSeconds": 1,
                  "MaxAttempts": 3,
                  "BackoffRate": 2,
                  "JitterStrategy": "FULL"
                }
              ],
              "Next": "Run Sequali and upload to s3",
              "Assign": {
                "ephemeralStorageSizeInGiB": "{% $states.result.Payload.ephemeralStorageSizeInGiB %}"
              }
            },
            "Run Sequali and upload to s3": {
              "Type": "Task",
              "Resource": "arn:aws:states:::ecs:runTask.sync",
              "Arguments": {
                "LaunchType": "FARGATE",
                "Cluster": "${__get_sequali_stats_cluster_arn__}",
                "TaskDefinition": "${__get_sequali_stats_task_definition_arn__}",
                "NetworkConfiguration": {
                  "AwsvpcConfiguration": {
                    "Subnets": "{% $split('${__get_sequali_stats_subnets__}', ',') %}",
                    "SecurityGroups": "{% [ '${__get_sequali_stats_security_group__}' ] %}"
                  }
                },
                "Overrides": {
                  "ContainerOverrides": [
                    {
                      "Name": "${__get_sequali_stats_container_name__}",
                      "Environment": [
                        {
                          "Name": "FASTQ_ID",
                          "Value": "{% $fastqId %}"
                        },
                        {
                          "Name": "LIBRARY_ID",
                          "Value": "{% $libraryId %}"
                        },
                        {
                          "Name": "READ_COUNT",
                          "Value": "{% $fastqObj.readCount != null ? $string($fastqObj.readCount) : null %}"
                        },
                        {
                          "Name": "BASE_COUNT_EST",
                          "Value": "{% $fastqObj.baseCountEst != null ? $string($fastqObj.baseCountEst) : null %}"
                        },
                        {
                          "Name": "R1_INPUT_URI",
                          "Value": "{% ($exists($sequaliS3Objs) ? $sequaliS3Objs : $s3Objs)[0].s3Uri %}"
                        },
                        {
                          "Name": "R2_INPUT_URI",
                          "Value": "{% ($exists($sequaliS3Objs) ? $sequaliS3Objs : $s3Objs)[1] ? ($exists($sequaliS3Objs) ? $sequaliS3Objs : $s3Objs)[1].s3Uri : null %}"
                        },
                        {
                          "Name": "OUTPUT_SEQUALI_JSON_SUMMARY_URI",
                          "Value": "{% 's3://' & $cacheBucket & '/' & $cacheKey %}"
                        },
                        {
                          "Name": "OUTPUT_SEQUALI_HTML_URI",
                          "Value": "{% 's3://' & $sequaliBucket & '/' & $sequaliHtmlKey %}"
                        },
                        {
                          "Name": "OUTPUT_SEQUALI_PARQUET_URI",
                          "Value": "{% 's3://' & $sequaliBucket & '/' & $sequaliParquetKey %}"
                        },
                        {
                          "Name": "OUTPUT_MULTIQC_HTML_URI",
                          "Value": "{% 's3://' & $sequaliBucket & '/' & $multiqcHtmlKey %}"
                        },
                        {
                          "Name": "OUTPUT_MULTIQC_PARQUET_URI",
                          "Value": "{% 's3://' & $sequaliBucket & '/' & $multiqcParquetKey %}"
                        }
                      ]
                    }
                  ],
                  "EphemeralStorage": {
                    "SizeInGiB": "{% $ephemeralStorageSizeInGiB ? $ephemeralStorageSizeInGiB : ${__default_ephemeral_storage_size_gib__} %}"
                  }
                }
              },
              "Next": "Get sequali outputs",
              "Catch": [
                {
                  "ErrorEquals": ["States.ALL"],
                  "Assign": {
                    "jobStatus": "FAILED"
                  },
                  "Next": "Sequali Branch Result"
                }
              ],
              "Assign": {
                "jobStatus": "SUCCEEDED"
              },
              "Retry": [
                {
                  "ErrorEquals": ["ECS.AmazonECSException"],
                  "BackoffRate": 2,
                  "IntervalSeconds": 20,
                  "MaxAttempts": 3,
                  "JitterStrategy": "FULL"
                }
              ]
            },
            "Get sequali outputs": {
              "Type": "Task",
              "Arguments": {
                "Bucket": "{% $cacheBucket %}",
                "Key": "{% $cacheKey %}"
              },
              "Resource": "arn:aws:states:::aws-sdk:s3:getObject",
              "Next": "Sequali Branch Result",
              "Assign": {
                "sequaliData": "{% /* https://docs.jsonata.org/string-functions#eval */\n$parse($states.result.Body) %}"
              },
              "Catch": [
                {
                  "ErrorEquals": ["States.ALL"],
                  "Next": "Sequali Branch Result",
                  "Assign": {
                    "jobStatus": "FAILED"
                  }
                }
              ]
            },
            "Sequali Branch Result": {
              "Type": "Pass",
              "Output": "{% { 'jobStatus': ($exists($jobStatus) ? $jobStatus : 'SUCCEEDED'), 'sequaliData': ($exists($sequaliData) ? $sequaliData : null) } %}",
              "End": true
            }
          }
        },
        {
          "StartAt": "Is ORA compression (picard)",
          "States": {
            "Is ORA compression (picard)": {
              "Type": "Choice",
              "Choices": [
                {
                  "Next": "Decompress Fastqs (picard)",
                  "Condition": "{% $fastqObj.readSet.compressionFormat = 'ORA' %}",
                  "Comment": "Is ORA Compression Format"
                }
              ],
              "Default": "Run Picard Insert Size and upload to s3"
            },
            "Decompress Fastqs (picard)": {
              "Type": "Task",
              "Resource": "arn:aws:states:::events:putEvents.waitForTaskToken",
              "Arguments": {
                "Entries": [
                  {
                    "Detail": {
                      "taskToken": "{% $states.context.Task.Token %}",
                      "payload": {
                        "fastqIdList": ["{% $fastqId %}"],
                        "maxReads": "{% (\"${__max_picard_reads__}\" ~> $number) %}",
                        "sampling": true
                      }
                    },
                    "DetailType": "${__ora_decompression_request_detail_type__}",
                    "EventBusName": "${__event_bus_name__}",
                    "Source": "${__stack_source__}"
                  }
                ]
              },
              "Next": "Run Picard Insert Size and upload to s3",
              "Catch": [
                {
                  "ErrorEquals": ["States.TaskFailed"],
                  "Next": "Picard Branch Result",
                  "Assign": {
                    "jobStatus": "FAILED"
                  }
                }
              ],
              "Assign": {
                "picardS3Objs": "{% (\n    $getFastqIngestIdList := function($decompressedFileList, $fastqId) {(\n        /* Start with the decompressedFileList input */\n        $decompressedFileList ~>\n        /* Get the only item in the list where the fastq id matches */\n        $single(\n            function($decompressedFileListIter){\n                $decompressedFileListIter.fastqId = $fastqId\n            }\n        ) ~>\n        /* Get the ingest id list */\n        $lookup('decompressedFileUriByOraFileIngestIdList')\n    )};\n    $getR1FileObjFilter := function($s3ObjIter){\n        $s3ObjIter.ingestId = $s3Objs[0].ingestId\n    };\n    $getR2FileObjFilter := function($s3ObjIter) {(\n        $s3ObjIter.ingestId = $s3Objs[1].ingestId\n    )};\n    $getFileUri := function($fastqFileList, $filterFunction){\n        /* Start with the fastq file list */\n        $fastqFileList ~>\n        /* Pipe into single, which collects the filter function */\n        $single($filterFunction) ~>\n        /* And then get the gzipFileUri attribute */\n        $lookup('gzipFileUri')\n    };\n\n    /* Start with the decompressedFileList input */\n    $fastqFileList := $getFastqIngestIdList(\n        $states.result.decompressedFileList,\n        $fastqId\n    );\n\n    /* Collect the iterable that matches the ingest id */\n    [\n        {\n            's3Uri': ($fastqFileList ~> $getFileUri($getR1FileObjFilter))\n        },\n        {\n            's3Uri': ($fastqFileList ~> $getFileUri($getR2FileObjFilter))\n        }\n    ]\n) %}"
              },
              "Retry": [
                {
                  "ErrorEquals": ["States.HeartbeatTimeout"],
                  "BackoffRate": 2,
                  "IntervalSeconds": 1,
                  "MaxAttempts": 1
                }
              ],
              "HeartbeatSeconds": 3600
            },
            "Run Picard Insert Size and upload to s3": {
              "Type": "Task",
              "Resource": "arn:aws:states:::ecs:runTask.sync",
              "Arguments": {
                "LaunchType": "FARGATE",
                "Cluster": "${__get_insert_size_metrics_cluster_arn__}",
                "TaskDefinition": "${__get_insert_size_metrics_task_definition_arn__}",
                "NetworkConfiguration": {
                  "AwsvpcConfiguration": {
                    "Subnets": "{% $split('${__get_insert_size_metrics_subnets__}', ',') %}",
                    "SecurityGroups": "{% [ '${__get_insert_size_metrics_security_group__}' ] %}"
                  }
                },
                "Overrides": {
                  "ContainerOverrides": [
                    {
                      "Name": "${__get_insert_size_metrics_container_name__}",
                      "Environment": [
                        {
                          "Name": "FASTQ_ID",
                          "Value": "{% $fastqId %}"
                        },
                        {
                          "Name": "LIBRARY_ID",
                          "Value": "{% $libraryId %}"
                        },
                        {
                          "Name": "R1_INPUT_URI",
                          "Value": "{% ($exists($picardS3Objs) ? $picardS3Objs : $s3Objs)[0].s3Uri %}"
                        },
                        {
                          "Name": "R2_INPUT_URI",
                          "Value": "{% ($exists($picardS3Objs) ? $picardS3Objs : $s3Objs)[1] ? ($exists($picardS3Objs) ? $picardS3Objs : $s3Objs)[1].s3Uri : null %}"
                        },
                        {
                          "Name": "REF_GENOME_URI",
                          "Value": "${__reference_genome_uri__}"
                        },
                        {
                          "Name": "MAX_PICARD_READS",
                          "Value": "${__max_picard_reads__}"
                        },
                        {
                          "Name": "OUTPUT_PICARD_PDF_URI",
                          "Value": "{% 's3://' & $picardBucket & '/' & $picardPdfKey %}"
                        },
                        {
                          "Name": "OUTPUT_PICARD_PARQUET_URI",
                          "Value": "{% 's3://' & $picardBucket & '/' & $picardParquetKey %}"
                        },
                        {
                          "Name": "OUTPUT_MULTIQC_HTML_URI",
                          "Value": "{% 's3://' & $picardBucket & '/' & $multiqcPicardHtmlKey %}"
                        },
                        {
                          "Name": "OUTPUT_MULTIQC_PARQUET_URI",
                          "Value": "{% 's3://' & $picardBucket & '/' & $multiqcPicardParquetKey %}"
                        },
                        {
                          "Name": "OUTPUT_INSERT_SIZE_ESTIMATE_URI",
                          "Value": "{% 's3://' & $cacheBucket & '/' & $picardSummaryKey %}"
                        }
                      ]
                    }
                  ]
                }
              },
              "Next": "Get picard insert size output",
              "Catch": [
                {
                  "ErrorEquals": ["States.ALL"],
                  "Assign": {
                    "jobStatus": "FAILED"
                  },
                  "Next": "Picard Branch Result"
                }
              ],
              "Assign": {
                "jobStatus": "SUCCEEDED"
              },
              "Retry": [
                {
                  "ErrorEquals": ["ECS.AmazonECSException"],
                  "BackoffRate": 2,
                  "IntervalSeconds": 20,
                  "MaxAttempts": 3,
                  "JitterStrategy": "FULL"
                }
              ]
            },
            "Get picard insert size output": {
              "Type": "Task",
              "Arguments": {
                "Bucket": "{% $cacheBucket %}",
                "Key": "{% $picardSummaryKey %}"
              },
              "Resource": "arn:aws:states:::aws-sdk:s3:getObject",
              "Next": "Picard Branch Result",
              "Assign": {
                "insertSizeEstimate": "{% $parse($states.result.Body).insertSizeEstimate %}",
                "insertSizeStdEstimate": "{% $parse($states.result.Body).insertSizeStdEstimate %}"
              },
              "Catch": [
                {
                  "ErrorEquals": ["States.ALL"],
                  "Next": "Picard Branch Result",
                  "Assign": {
                    "jobStatus": "FAILED"
                  }
                }
              ]
            },
            "Picard Branch Result": {
              "Type": "Pass",
              "Output": "{% { 'jobStatus': ($exists($jobStatus) ? $jobStatus : 'SUCCEEDED'), 'insertSizeEstimate': ($exists($insertSizeEstimate) ? $insertSizeEstimate : null), 'insertSizeStdEstimate': ($exists($insertSizeStdEstimate) ? $insertSizeStdEstimate : null) } %}",
              "End": true
            }
          }
        }
      ]
    },
    "Merge branch outputs": {
      "Type": "Pass",
      "Next": "Update job object",
      "Assign": {
        "jobStatus": "{% ($states.input[0].jobStatus = 'SUCCEEDED' and $states.input[1].jobStatus = 'SUCCEEDED') ? 'SUCCEEDED' : 'FAILED' %}",
        "sequaliData": "{% $states.input[0].sequaliData %}",
        "insertSizeEstimate": "{% $states.input[1].insertSizeEstimate %}",
        "insertSizeStdEstimate": "{% $states.input[1].insertSizeStdEstimate %}"
      }
    },
    "Update job object": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Output": "{% $states.result.Payload %}",
      "Arguments": {
        "FunctionName": "${__update_job_object_lambda_function_arn__}",
        "Payload": {
          "jobId": "{% $jobId %}",
          "jobStatus": "{% $jobStatus %}"
        }
      },
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException"
          ],
          "IntervalSeconds": 1,
          "MaxAttempts": 3,
          "BackoffRate": 2,
          "JitterStrategy": "FULL"
        }
      ],
      "Next": "Job Status is Succeeded"
    },
    "Job Status is Succeeded": {
      "Type": "Choice",
      "Choices": [
        {
          "Next": "Initialize Sync Retry Count",
          "Condition": "{% $jobStatus = 'SUCCEEDED' %}",
          "Comment": "Job Status Is Succeeded"
        }
      ],
      "Default": "Fail"
    },
    "Initialize Sync Retry Count": {
      "Type": "Pass",
      "Assign": {
        "syncRetryCount": 0
      },
      "Next": "Sync and Check Filemanager"
    },
    "Sync and Check Filemanager": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Output": "{% $states.result.Payload %}",
      "Arguments": {
        "FunctionName": "${__filemanager_sync_and_check_lambda_function_arn__}",
        "Payload": {
          "bucket": "{% $sequaliBucket %}",
          "keys": [
            "{% $sequaliHtmlKey %}",
            "{% $sequaliParquetKey %}",
            "{% $multiqcHtmlKey %}",
            "{% $multiqcParquetKey %}",
            "{% $picardPdfKey %}",
            "{% $picardParquetKey %}",
            "{% $multiqcPicardHtmlKey %}",
            "{% $multiqcPicardParquetKey %}"
          ],
          "prefix": "{% $sequaliMidFix %}"
        }
      },
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException"
          ],
          "IntervalSeconds": 1,
          "MaxAttempts": 3,
          "BackoffRate": 2,
          "JitterStrategy": "FULL"
        }
      ],
      "Next": "All Files Exist?"
    },
    "All Files Exist?": {
      "Type": "Choice",
      "Choices": [
        {
          "Next": "Update fastq object",
          "Condition": "{% $states.input.allFilesExist = true %}",
          "Comment": "All files are indexed"
        },
        {
          "Next": "Sync Check Failed",
          "Condition": "{% $states.input.allFilesExist = false and $syncRetryCount >= 12 %}",
          "Comment": "Max retries exceeded"
        }
      ],
      "Default": "Wait Before Retry"
    },
    "Wait Before Retry": {
      "Type": "Wait",
      "Seconds": 5,
      "Next": "Increment Retry Count"
    },
    "Increment Retry Count": {
      "Type": "Pass",
      "Assign": {
        "syncRetryCount": "{% $syncRetryCount + 1 %}"
      },
      "Next": "Sync and Check Filemanager"
    },
    "Sync Check Failed": {
      "Type": "Fail",
      "Error": "SyncCheckFailed",
      "Cause": "Filemanager sync check failed after 12 retries"
    },
    "Update fastq object": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Arguments": {
        "FunctionName": "${__update_fastq_object_lambda_function_arn__}",
        "Payload": {
          "fastqId": "{% $fastqId %}",
          "qc": "{% [\n  /* Metadata for sequali */\n  $sequaliData,\n  /* Picard-derived insert size estimates, override any value carried in sequaliData */\n  {\n    'insertSizeEstimate': $insertSizeEstimate,\n    'insertSizeStdEstimate': $insertSizeStdEstimate\n  },\n  /* Output URIs for multiqc and sequali html and parquet reports */\n  {\n    'sequaliReports': {\n      'sequaliHtml': {\n        's3Uri': 's3://' & $sequaliBucket & '/' & $sequaliHtmlKey\n      },\n      'sequaliParquet': {\n        's3Uri': 's3://' & $sequaliBucket & '/' & $sequaliParquetKey\n      },\n      'multiqcHtml': {\n        's3Uri': 's3://' & $sequaliBucket & '/' & $multiqcHtmlKey\n      },\n      'multiqcParquet': {\n        's3Uri': 's3://' & $sequaliBucket & '/' & $multiqcParquetKey\n      }\n    }\n  },\n  /* Output URIs for picard insert size reports */\n  {\n    'picard': {\n      'collectInsertSizeParquet': {\n        's3Uri': 's3://' & $picardBucket & '/' & $picardParquetKey\n      },\n      'collectInsertSizePdf': {\n        's3Uri': 's3://' & $picardBucket & '/' & $picardPdfKey\n      },\n      'multiqcHtml': {\n        's3Uri': 's3://' & $picardBucket & '/' & $multiqcPicardHtmlKey\n      },\n      'multiqcParquet': {\n        's3Uri': 's3://' & $picardBucket & '/' & $multiqcPicardParquetKey\n      }\n    }\n  }\n] ~>\n$merge %}"
        }
      },
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException"
          ],
          "IntervalSeconds": 1,
          "MaxAttempts": 3,
          "BackoffRate": 2,
          "JitterStrategy": "FULL"
        }
      ],
      "End": true
    },
    "Fail": {
      "Type": "Fail"
    }
  },
  "QueryLanguage": "JSONata"
}
